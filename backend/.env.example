# Server
APP_PORT=8080

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=video_site
DB_USER=root
DB_PASSWORD=your_db_password

# Flyway (MySQL 8.4 兼容阶段默认关闭)
FLYWAY_ENABLED=false

# Admin account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# CORS
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Storage
LOCAL_STORAGE_ROOT=../

# FFmpeg / Workers
FFMPEG_BIN=ffmpeg
UPLOAD_MAX_FILE_SIZE=1024MB
UPLOAD_MAX_REQUEST_SIZE=1024MB
TOMCAT_MAX_SWALLOW_SIZE=-1
TRANSCODE_WORKER_CRON=0/10 * * * * ?
TRANSCODE_WORKER_BATCH_SIZE=1
TRANSCODE_MAX_RETRY=3
COVER_ANALYSIS_WORKER_CRON=0/20 * * * * ?
RECOMMEND_WORKER_CRON=0 5 * * * ?

# Auto cover generation
COVER_AUTO_ENABLED=true
COVER_AUTO_SNAPSHOT_SECOND=3
COVER_AUTO_EXTERNAL_TITLE_ENABLED=true
