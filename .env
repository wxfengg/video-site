# ========== App ==========
APP_ENV=dev
APP_PORT=8080

# ========== MySQL ==========
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=video_site
DB_USER=root
DB_PASSWORD=
FLYWAY_ENABLED=false

# ========== Admin Auth ==========
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
CORS_ALLOWED_ORIGIN=http://localhost:5173

# ========== FFmpeg ==========
FFMPEG_BIN=E:\\environment\\ffmpeg-N-123588-g9c63742425-win64-gpl-shared\\bin\\ffmpeg.exe
FFPROBE_BIN=ffprobe

# 上传大小限制（本地调试大文件）
UPLOAD_MAX_FILE_SIZE=1024MB
UPLOAD_MAX_REQUEST_SIZE=1024MB
TOMCAT_MAX_SWALLOW_SIZE=-1

# ========== Storage ==========
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=./data/storage

# OSS (预留，启用时将 STORAGE_PROVIDER 改为 oss)
OSS_ENDPOINT=REPLACE_ME
OSS_REGION=REPLACE_ME
OSS_BUCKET=REPLACE_ME
OSS_ACCESS_KEY_ID=REPLACE_ME
OSS_ACCESS_KEY_SECRET=REPLACE_ME
OSS_PUBLIC_BASE_URL=REPLACE_ME

# ========== Cover Tag Analyzer ==========
COVER_ANALYZER_PROVIDER=rule

# 百度云视觉（预留）
BAIDU_VISION_API_KEY=REPLACE_ME
BAIDU_VISION_SECRET_KEY=REPLACE_ME

# ========== Scheduler / Recommendation ==========
RECOMMEND_REBUILD_CRON=0 5 * * * ?
TRANSCODE_WORKER_CRON=0/10 * * * * ?
TRANSCODE_WORKER_BATCH_SIZE=1
TRANSCODE_MAX_RETRY=3
COVER_ANALYZE_WORKER_CRON=0/15 * * * * ?

# 混合推荐权重
RECOMMEND_ALPHA=0.60
RECOMMEND_BETA=0.25
RECOMMEND_GAMMA=0.15
